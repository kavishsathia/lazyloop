program        = loop ;
loop           = goal | foreach ;
goal           = "goal" "{" { goal-statement } "}" [ "with" flow ] ;
flow           = "flow" "{" flow-statement { flow-statement } "}" ;
foreach        = "foreach" identifier "in" expression
                 "{" loop "}" ;
goal-statement = verify | trap | limit | policy | return ;
flow-statement = step | if | exec | wait | trap | judge ;
step           = "step" identifier "=" ( expression | loop | fork ) ";" ;
fork           = "fork" ;
if             = "if" expression "{" { flow-statement } "}" ;
exec           = "exec" ( identifier | string ) ";" ;
wait           = "wait" expression ";" ;
trap           = "trap" identifier "=" expression ";" ;
judge          = "judge" identifier "=" expression ";" ;
verify         = "verify" identifier "=" expression ";" ;
limit          = "limit" identifier expression ";" ;
policy         = ( "allow" | "disallow" ) expression ";" ;
return         = "return" expression ";" ;
expression     = primary { operator primary } ;
primary        = identifier | string | number | boolean | list | call | member
               | "(" expression ")" | "!" primary ;
list           = "[" [ expression { "," expression } ] "]" ;
call           = primary "(" [ argument { "," argument } ] ")" ;
argument       = [ identifier ":" ] expression ;
member         = primary "." identifier ;
operator       = "||" | "&&" | "==" | "!=" | "<" | "<=" | ">" | ">=" ;
boolean        = "true" | "false" ;
